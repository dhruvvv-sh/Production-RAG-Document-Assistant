APP_ENV=development
DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag_assistant
MAX_UPLOAD_SIZE_MB=25
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=80
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RETRIEVAL_DENSE_WEIGHT=0.55
RETRIEVAL_CANDIDATE_LIMIT=50
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_LIMIT=20
RERANKER_BATCH_SIZE=16
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=60
FAITHFULNESS_MODEL=cross-encoder/nli-deberta-v3-small
FAITHFULNESS_BATCH_SIZE=16
CLAIM_SUPPORT_THRESHOLD=0.5
